---
import '../styles/global.css';
import { CITIES } from '../lib/time/cities';

interface Props {
  title: string;
  description: string;
  path?: string;
  image?: string;
}

const { title, description, path, image } = Astro.props;
// `Astro.site` is a URL and already includes its trailing slash. Normalising
// it here prevents JSON-LD URLs below from accidentally becoming `//`.
const origin = new URL(Astro.site ?? Astro.url.origin);
const canonical = new URL(path ?? Astro.url.pathname, origin);
const ogImage = new URL(image ?? '/og.png', origin);

/** Current path, normalised without a trailing slash, for marking the active nav item. */
const here = (path ?? Astro.url.pathname).replace(/\/+$/, '') || '/';

const navLinks = [
  { href: '/', label: 'World clock', shortLabel: 'Clock' },
  { href: '/overlap', label: 'Meeting planner', shortLabel: 'Planner' },
];

/*
 * Footer links are derived from the city data rather than hand-written, because
 * hand-writing them is exactly what produced dead links the first time round:
 * a pair page only exists between two hubs in different zones, in alphabetical
 * slug order. Resolving them here means a typo or a dataset change cannot ship
 * a 404 in the footer of all 642 pages.
 */
const bySlug = new Map(CITIES.map((c) => [c.slug, c]));

const footerCitySlugs = ['london', 'new-york', 'tokyo', 'sydney', 'singapore', 'los-angeles'];
const footerCities = footerCitySlugs.map((s) => bySlug.get(s)).filter((c) => c !== undefined);

const footerPairSlugs: Array<[string, string]> = [
  ['london', 'new-york'],
  ['london', 'sydney'],
  ['new-york', 'tokyo'],
  ['london', 'tokyo'],
  ['london', 'los-angeles'],
  ['new-york', 'singapore'],
];

const footerPairs = footerPairSlugs
  .map(([x, y]) => {
    const a = bySlug.get(x);
    const b = bySlug.get(y);
    // Same conditions as hubPairs(): both hubs, different zones.
    if (!a || !b || !a.isHub || !b.isHub || a.timeZone === b.timeZone) return null;
    const [first, second] = a.slug < b.slug ? [a, b] : [b, a];
    return {
      href: `/difference/${first.slug}/${second.slug}`,
      label: `${first.name} / ${second.name}`,
    };
  })
  .filter((p) => p !== null);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Hours Apart — a world clock that shows whether it is light there"
    />
    <meta property="og:site_name" content="Hours Apart" />
    <meta property="og:locale" content="en" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#fdfcf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12141f" media="(prefers-color-scheme: dark)" />

    {
      /*
      One entity for the whole site, identified by @id so every page's JSON-LD
      resolves to the same thing. It used to be a `WebApplication` named after
      the current page title, which claimed 658 differently-named apps.
    */
    }
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'WebSite',
            '@id': `${origin}#website`,
            url: origin.href,
            name: 'Hours Apart',
            description:
              'A world clock that shows whether it is light there, and warns you before daylight saving moves a recurring meeting.',
            inLanguage: 'en',
          },
          {
            '@type': 'WebApplication',
            '@id': `${origin}#app`,
            url: origin.href,
            name: 'Hours Apart',
            applicationCategory: 'BusinessApplication',
            operatingSystem: 'Any',
            browserRequirements: 'Requires JavaScript for the live clock',
            isPartOf: { '@id': `${origin}#website` },
            offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
          },
          {
            '@type': 'WebPage',
            '@id': `${canonical.href}#page`,
            url: canonical.href,
            name: title,
            description,
            isPartOf: { '@id': `${origin}#website` },
            inLanguage: 'en',
          },
        ],
      })}
    />
    {
      /*
      Runs before first paint so the page never flashes the wrong palette. It
      only makes the coarse light/dark call, since the precise sky state needs
      the solar module and a deferred script is too late to matter visually.
    */
    }
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('sky-mode');
          if (stored === 'light') return void (document.documentElement.dataset.sky = 'day');
          if (stored === 'dark') return void (document.documentElement.dataset.sky = 'night');
          const dark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.sky = dark ? 'night' : 'day';
        } catch {
          document.documentElement.dataset.sky = 'day';
        }
      })();
    </script>

    <slot name="head" />
  </head>

  <body class="bg-paper-50 text-paper-900 font-sans antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-paper-900 focus:px-3 focus:py-2 focus:text-paper-50"
    >
      Skip to content
    </a>

    <header class="sticky top-0 z-40 border-b border-paper-200/80 bg-paper-50/88 backdrop-blur-xl">
      <div
        class="mx-auto flex h-[4.25rem] max-w-6xl items-center justify-between gap-3 px-5 sm:px-8"
      >
        <a
          href="/"
          class="ring-focus flex min-w-0 items-center gap-2.5 rounded-lg"
          aria-label="Hours Apart, home"
        >
          <span
            class="brand-mark flex h-8 w-8 shrink-0 items-center justify-center rounded-xl border border-paper-200 elev"
            aria-hidden="true"
          >
            <svg width="22" height="22" viewBox="0 0 32 32">
              <circle cx="13" cy="16" r="7.2" fill="none" stroke="currentColor" stroke-width="2"
              ></circle>
              <circle cx="19" cy="16" r="7.2" fill="none" stroke="currentColor" stroke-width="2"
              ></circle>
              <path d="M16 9.5a7.2 7.2 0 0 0 0 13 7.2 7.2 0 0 0 0-13Z" fill="var(--color-go-500)"
              ></path>
            </svg>
          </span>
          <span class="truncate text-[15px] font-semibold tracking-tight text-paper-900"
            >Hours Apart</span
          >
          <span class="hidden border-l border-paper-200 pl-3 text-[11px] text-paper-500 lg:inline"
            >World time, made human</span
          >
        </a>

        <nav
          aria-label="Main"
          class="flex shrink-0 items-center gap-0.5 rounded-xl border border-paper-200 bg-white/75 p-1 text-sm elev"
        >
          {
            navLinks.map((link) => {
              const active = here === link.href;
              return (
                <a
                  href={link.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'ring-focus rounded-lg px-3 py-1.5 font-medium transition-colors',
                    active
                      ? 'bg-paper-900 text-paper-50'
                      : 'text-paper-500 hover:bg-paper-100 hover:text-paper-900',
                  ]}
                >
                  <span class="sm:hidden">{link.shortLabel}</span>
                  <span class="hidden sm:inline">{link.label}</span>
                </a>
              );
            })
          }
        </nav>
      </div>
    </header>

    <main id="main" class="mx-auto max-w-6xl px-5 py-8 sm:px-8 sm:py-12">
      <slot />
    </main>

    <footer class="mt-24 border-t border-paper-200">
      <div class="mx-auto max-w-6xl px-5 py-14 sm:px-8">
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
          <div class="sm:col-span-2 lg:col-span-1">
            <div class="flex items-center gap-2">
              <svg width="20" height="20" viewBox="0 0 32 32" aria-hidden="true">
                <circle cx="13" cy="16" r="7.2" fill="none" stroke="currentColor" stroke-width="2"
                ></circle>
                <circle cx="19" cy="16" r="7.2" fill="none" stroke="currentColor" stroke-width="2"
                ></circle>
                <path d="M16 9.5a7.2 7.2 0 0 0 0 13 7.2 7.2 0 0 0 0-13Z" fill="var(--color-go-500)"
                ></path>
              </svg>
              <span class="text-sm font-semibold tracking-tight text-paper-900">Hours Apart</span>
            </div>
            <p class="mt-3 text-xs leading-relaxed text-paper-500">
              A world clock that tells you whether it is light there, and warns you before daylight
              saving moves a recurring meeting.
            </p>
          </div>

          <div>
            <h2 class="text-xs font-semibold tracking-wide text-paper-900 uppercase">Tools</h2>
            <ul class="mt-3 space-y-2 text-sm">
              <li>
                <a href="/" class="ring-focus rounded text-paper-700 hover:text-paper-900">
                  World clock
                </a>
              </li>
              <li>
                <a href="/overlap" class="ring-focus rounded text-paper-700 hover:text-paper-900">
                  Meeting planner
                </a>
              </li>
              <li>
                <a href="/privacy" class="ring-focus rounded text-paper-700 hover:text-paper-900">
                  Privacy
                </a>
              </li>
              <li>
                <a href="/contact" class="ring-focus rounded text-paper-700 hover:text-paper-900">
                  Contact &amp; feedback
                </a>
              </li>
            </ul>
          </div>

          <div>
            <h2 class="text-xs font-semibold tracking-wide text-paper-900 uppercase">
              Popular cities
            </h2>
            <p class="mt-3 text-sm">
              <a href="/time" class="ring-focus rounded font-medium text-paper-900 hover:underline">
                All cities
              </a>
            </p>
            <ul class="mt-3 space-y-2 text-sm">
              {
                footerCities.map((city) => (
                  <li>
                    <a
                      href={`/time/${city.slug}`}
                      class="ring-focus rounded text-paper-700 hover:text-paper-900"
                    >
                      Time in {city.name}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <h2 class="text-xs font-semibold tracking-wide text-paper-900 uppercase">
              Time differences
            </h2>
            <p class="mt-3 text-sm">
              <a
                href="/difference"
                class="ring-focus rounded font-medium text-paper-900 hover:underline"
              >
                All city pairs
              </a>
            </p>
            <ul class="mt-3 space-y-2 text-sm">
              {
                footerPairs.map((pair) => (
                  <li>
                    <a
                      href={pair.href}
                      class="ring-focus rounded text-paper-700 hover:text-paper-900"
                    >
                      {pair.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>

        <div
          class="mt-10 flex flex-col gap-4 border-t border-paper-200 pt-6 text-xs leading-relaxed text-paper-500 sm:flex-row sm:items-start sm:justify-between"
        >
          <p class="max-w-md">
            Time zone data comes from your own device's IANA database, so it is as current as your
            browser. Hours Apart has no form or account backend; details only leave your device when
            you choose an external calendar or email action.
          </p>

          <div class="flex flex-wrap items-center gap-1.5 sm:justify-end">
            <span id="sky-label" class="mr-1">Theme</span>
            <div role="group" aria-labelledby="sky-label" class="flex gap-1">
              <button
                type="button"
                data-sky-mode="auto"
                title="Switch between light and dark as day turns to night where you are"
                class="ring-focus rounded-md border border-paper-200 px-2 py-1 hover:text-paper-900"
              >
                Automatic
              </button>
              <button
                type="button"
                data-sky-mode="light"
                class="ring-focus rounded-md border border-paper-200 px-2 py-1 hover:text-paper-900"
              >
                Light
              </button>
              <button
                type="button"
                data-sky-mode="dark"
                class="ring-focus rounded-md border border-paper-200 px-2 py-1 hover:text-paper-900"
              >
                Dark
              </button>
            </div>
            <span id="sky-state" class="ml-1 w-full opacity-70 sm:w-auto"></span>
          </div>
        </div>
      </div>
    </footer>

    <script>
      import { skyState } from '../lib/time/solar';
      import { latitudeFor } from '../lib/time/cities';
      import { localTimeZone } from '../lib/time/zone';

      /**
       * Refine the coarse light/dark guess made in the head into the real sky
       * state where the reader is, and keep it current as the evening comes in.
       *
       * A stored preference always wins. Automatically dragging someone into a
       * dark interface with no way out would be worse than not doing it at all.
       */
      type Mode = 'auto' | 'light' | 'dark';

      const readMode = (): Mode => {
        try {
          const stored = localStorage.getItem('sky-mode');
          return stored === 'light' || stored === 'dark' ? stored : 'auto';
        } catch {
          return 'auto';
        }
      };

      function apply(mode: Mode) {
        const root = document.documentElement;
        const label = document.getElementById('sky-state');

        if (mode === 'light' || mode === 'dark') {
          root.dataset.sky = mode === 'light' ? 'day' : 'night';
          if (label) label.textContent = '';
        } else {
          const timeZone = localTimeZone();
          const { state, approximate } = skyState(new Date(), timeZone, latitudeFor(timeZone));
          root.dataset.sky = state;
          if (label) {
            const localState =
              state === 'day' ? 'Daylight' : state === 'twilight' ? 'Twilight' : 'Night';
            label.textContent = approximate
              ? `${localState} where you are, estimated`
              : `${localState} where you are`;
          }
        }

        for (const button of document.querySelectorAll<HTMLButtonElement>('[data-sky-mode]')) {
          const active = button.dataset.skyMode === mode;
          button.setAttribute('aria-pressed', String(active));
          button.classList.toggle('bg-paper-900', active);
          button.classList.toggle('text-paper-50', active);
        }
      }

      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-sky-mode]')) {
        button.addEventListener('click', () => {
          const mode = (button.dataset.skyMode ?? 'auto') as Mode;
          try {
            if (mode === 'auto') localStorage.removeItem('sky-mode');
            else localStorage.setItem('sky-mode', mode);
          } catch {
            // Private browsing: the choice just will not persist.
          }
          apply(mode);
        });
      }

      apply(readMode());
      // Twilight is short; re-checking each minute catches the handover.
      window.setInterval(() => apply(readMode()), 60_000);
    </script>
  </body>
</html>
