---
import Base from '../layouts/Base.astro';

const title = 'Hours Apart changelog';
const description = 'Product, content and policy updates to Hours Apart.';
---

<Base title={title} description={description} path="/changelog">
  <article class="max-w-2xl">
    <header class="mb-8">
      <p class="text-[11px] font-semibold tracking-[0.15em] text-paper-500 uppercase">Changelog</p>
      <h1 class="mt-2 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
        What has changed
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-paper-700">
        A short public record of meaningful product, content and policy updates. This is not a list
        of every tiny deployment.
      </p>
    </header>

    <div class="space-y-10">
      <section>
        <p class="text-xs font-semibold tracking-wide text-paper-500 uppercase">October 2026</p>
        <h2 class="mt-2 text-xl font-semibold tracking-tight">
          Published site policies and clearer guides
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-paper-700">
          Added Privacy and Terms pages, an explanation of the site&apos;s methods, and this
          changelog. Expanded the guide section to document recurring-meeting and daylight-saving
          decisions in plain language. Corrected the city-pair explanation so it does not imply that
          every DST mismatch involves opposite hemispheres.
        </p>
      </section>

      <section>
        <p class="text-xs font-semibold tracking-wide text-paper-500 uppercase">September 2026</p>
        <h2 class="mt-2 text-xl font-semibold tracking-tight">
          Improved search and sharing foundations
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-paper-700">
          Published the first public version of Hours Apart with city time pages, city-pair pages,
          the interactive world clock and a shareable meeting planner. Added canonical URLs,
          structured data, a sitemap and clearer navigation between the main tools.
        </p>
      </section>
    </div>
  </article>
</Base>
