---
import Base from '../layouts/Base.astro';

const title = 'Contact & feedback — Hours Apart';
const description =
  'Suggest an improvement or report a bug in Hours Apart through a short feedback form. No account needed.';
---

<Base title={title} description={description} path="/contact">
  <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-start">
    <article class="max-w-2xl">
      <header class="mb-7">
        <p class="text-[11px] font-semibold tracking-[0.15em] text-paper-500 uppercase">
          Help shape Hours Apart
        </p>
        <h1 class="mt-2 text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
          Contact &amp; feedback
        </h1>
        <p class="mt-3 max-w-xl text-paper-700">
          Found a time that looks wrong, hit a rough edge, or have an idea that would make planning
          easier? Send it through. Specific examples are especially useful.
        </p>

        <div class="mt-6 rounded-2xl border border-paper-200 bg-white p-5 elev">
          <p class="text-sm font-semibold">Quickest way</p>
          <p class="mt-1 text-sm leading-relaxed text-paper-700">
            A short form that works on any device, with no email app required.
          </p>
          <a
            href="https://tally.so/r/jaRql6"
            target="_blank"
            rel="noreferrer"
            class="ring-focus elev elev-hover mt-4 inline-flex rounded-xl bg-paper-900 px-5 py-3 text-sm font-semibold text-paper-50"
          >
            Open the feedback form
          </a>
          <p class="mt-3 text-[11px] leading-relaxed text-paper-500">
            The form is hosted by Tally, so it opens in a new tab. Nothing is sent anywhere until
            you choose to open it.
          </p>
        </div>
      </header>
    </article>

    <aside class="rounded-2xl border border-paper-200 bg-paper-100/55 p-5">
      <h2 class="text-sm font-semibold">A useful bug report includes</h2>
      <ul class="mt-3 space-y-2 text-sm leading-relaxed text-paper-700">
        <li class="flex gap-2">
          <span aria-hidden="true">01</span><span>The cities and date you were comparing</span>
        </li>
        <li class="flex gap-2">
          <span aria-hidden="true">02</span><span>What you expected to see</span>
        </li>
        <li class="flex gap-2">
          <span aria-hidden="true">03</span><span>What appeared instead</span>
        </li>
        <li class="flex gap-2">
          <span aria-hidden="true">04</span><span>Your browser or device, if relevant</span>
        </li>
      </ul>
      <p class="mt-5 border-t border-paper-200 pt-4 text-xs leading-relaxed text-paper-500">
        Pasting the share link from the page you were on covers most of this in one step.
      </p>
    </aside>
  </div>
</Base>
