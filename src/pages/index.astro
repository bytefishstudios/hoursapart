---
import Base from '../layouts/Base.astro';
import WorldClock from '../components/WorldClock.tsx';
import Faq from '../components/Faq.astro';

const title = 'World Clock — is it light there? | Hours Apart';
const description =
  'A clean world clock with a time slider. See the current time in any city, whether the sun is up, and how far ahead or behind you they are. Share your city list as a single link.';

const faqs = [
  {
    q: 'What does the coloured bar under each city mean?',
    a: "It is that city's whole day, from local midnight to midnight, shaded for daylight, twilight and darkness. The vertical marker is the moment you are looking at. It answers the question a plain clock cannot: not just what time it is there, but whether it is a reasonable hour to call.",
  },
  {
    q: 'How is daylight worked out?',
    a: "From the city's latitude and the date, using the standard solar position method. Latitude is stored per city rather than per time zone, because Miami and Boston share a clock but sit sixteen degrees apart, which puts about an hour and a half between their winter sunsets.",
  },
  {
    q: 'What is the slider for?',
    a: 'Pick any hour in your base city and every other city updates to match. It answers "if I schedule this for 3pm my time, what time is that for them" without any arithmetic. Press "Back to now" to return to the live clock.',
  },
  {
    q: 'Do you store my cities?',
    a: 'No. There is no account and no database. Your city list is encoded in the address bar, which is why you can bookmark it, reload it, or paste the link to a colleague and have them see exactly the same thing.',
  },
  {
    q: 'Where does the time zone data come from?',
    a: 'Your own device. Browsers ship the IANA time zone database and expose it through the Intl API, so offsets and daylight saving rules are as current as your operating system. Nothing is bundled here that could quietly go stale.',
  },
];
---

<Base title={title} description={description} path="/">
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    })}
  />

  <section class="home-hero relative pb-10 sm:pb-14">
    <div
      class="grid items-center gap-9 lg:grid-cols-[minmax(0,1.05fr)_minmax(24rem,0.95fr)] lg:gap-14"
    >
      <div>
        <p
          class="inline-flex items-center gap-2 rounded-full border border-paper-200 bg-white/80 px-3 py-1.5 text-xs font-medium text-paper-700 elev"
        >
          <span class="relative flex h-1.5 w-1.5" aria-hidden="true">
            <span
              class="absolute inline-flex h-full w-full animate-ping rounded-full bg-go-500 opacity-60"
            ></span>
            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-go-500"></span>
          </span>
          Live world time &middot; private by design
        </p>

        <h1
          class="mt-5 max-w-3xl text-[2.75rem] leading-[0.98] font-semibold tracking-[-0.045em] text-balance sm:text-6xl lg:text-[4.1rem]"
        >
          What time is it there&mdash;<span class="text-paper-500">and is the sun up?</span>
        </h1>

        <p class="mt-5 max-w-xl text-lg leading-relaxed text-paper-700 sm:text-xl">
          See everyone&rsquo;s local time, daylight and date in one calm view. Then choose a future
          hour without getting caught by daylight saving.
        </p>

        <div class="mt-7 flex flex-wrap items-center gap-3">
          <a
            href="#clock"
            class="ring-focus elev elev-hover rounded-xl bg-paper-900 px-5 py-3 text-sm font-semibold text-paper-50"
          >
            Open my world clock
          </a>
          <a
            href="/overlap"
            class="ring-focus rounded-xl border border-paper-200 bg-white/80 px-5 py-3 text-sm font-semibold text-paper-900 elev hover:border-paper-300"
          >
            Find an overlap <span aria-hidden="true">&rarr;</span>
          </a>
        </div>

        <p class="mt-5 text-xs leading-relaxed text-paper-500">
          112 cities with real latitudes <span aria-hidden="true">&middot;</span> no account
          <span aria-hidden="true">&middot;</span> every setup is a shareable link
        </p>
      </div>

      <aside
        class="hero-preview relative hidden overflow-hidden rounded-[1.75rem] border border-paper-200 bg-white p-6 elev-lift lg:block"
        aria-label="Example daylight saving change between London and Sydney"
      >
        <div class="relative z-10">
          <div class="flex items-center justify-between gap-3">
            <p class="text-[11px] font-semibold tracking-[0.16em] text-paper-500 uppercase">
              DST watch
            </p>
            <span
              class="rounded-full bg-warn-100 px-2.5 py-1 text-[10px] font-semibold text-warn-700"
              >Gap changes</span
            >
          </div>

          <div class="mt-7 grid grid-cols-[1fr_auto_1fr] items-center gap-4">
            <div>
              <p class="text-sm font-semibold">London</p>
              <p class="nums mt-1 text-3xl font-semibold tracking-tight">09:00</p>
              <p class="mt-1 text-xs text-paper-500">workday begins</p>
            </div>
            <div class="flex flex-col items-center" aria-hidden="true">
              <span class="h-2 w-2 rounded-full bg-go-500"></span>
              <span class="h-12 w-px bg-paper-200"></span>
              <span class="h-2 w-2 rounded-full bg-sky-day"></span>
            </div>
            <div class="text-right">
              <p class="text-sm font-semibold">Sydney</p>
              <p class="nums mt-1 text-3xl font-semibold tracking-tight">18:00</p>
              <p class="mt-1 text-xs text-paper-500">same moment</p>
            </div>
          </div>

          <div class="mt-7 rounded-2xl border border-paper-200 bg-paper-50/80 p-4">
            <div class="flex items-center justify-between gap-3 text-xs text-paper-500">
              <span>Across one year</span>
              <span>not one fixed gap</span>
            </div>
            <div class="mt-3 grid grid-cols-3 gap-2">
              <div class="rounded-xl border border-paper-200 bg-white px-3 py-2.5 text-center">
                <span class="nums block text-lg font-semibold">9h</span>
                <span class="text-[10px] text-paper-500">apart</span>
              </div>
              <div class="rounded-xl border border-warn-400/50 bg-warn-100 px-3 py-2.5 text-center">
                <span class="nums block text-lg font-semibold">10h</span>
                <span class="text-[10px] text-warn-700">apart</span>
              </div>
              <div class="rounded-xl border border-paper-200 bg-white px-3 py-2.5 text-center">
                <span class="nums block text-lg font-semibold">11h</span>
                <span class="text-[10px] text-paper-500">apart</span>
              </div>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section id="clock" class="scroll-mt-24 border-t border-paper-200 pt-8 sm:pt-10">
    <div class="mb-5 flex flex-wrap items-end justify-between gap-3">
      <div>
        <p class="text-[11px] font-semibold tracking-[0.16em] text-paper-500 uppercase">
          Your live workspace
        </p>
        <h2 class="mt-1.5 text-2xl font-semibold tracking-tight sm:text-3xl">
          Everyone, at the same moment
        </h2>
      </div>
      <p class="hidden max-w-xs text-right text-xs leading-relaxed text-paper-500 sm:block">
        Drag the time, change the date, rename cities and share the exact view.
      </p>
    </div>

    <WorldClock client:load />
  </section>

  <section class="mt-24 sm:mt-32">
    <p class="text-xs font-semibold tracking-widest text-paper-500 uppercase">The difference</p>
    <div class="mt-4 grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
      <div>
        <h2 class="text-2xl font-semibold tracking-tight text-balance sm:text-3xl">
          A time on its own does not tell you whether to call
        </h2>
        <p class="mt-4 leading-relaxed text-paper-700">
          &ldquo;It is 16:00 in Stockholm&rdquo; is a fact with almost no useful content. In June
          that is the middle of a long bright evening; in December the sun set an hour ago. The
          number is identical and the answer is the opposite.
        </p>
        <p class="mt-4 leading-relaxed text-paper-700">
          So every city here carries its own latitude rather than borrowing one from its time zone.
          Miami and Boston both run on <span class="whitespace-nowrap">America/New_York</span>, yet
          in midwinter the sun is still up in one and long gone in the other.
        </p>
      </div>

      {/* The same clock time in two months, shown rather than described. */}
      <div
        class="elev flex flex-col justify-center gap-6 rounded-2xl border border-paper-200 bg-white p-6"
      >
        {
          [
            {
              month: 'Stockholm in June',
              note: 'Sun still high. Hours of light left.',
              stops:
                'var(--color-sky-day) 0%, var(--color-sky-day) 80%, var(--color-sky-dusk) 92%, var(--color-sky-night) 100%',
            },
            {
              month: 'Stockholm in December',
              note: 'Set an hour ago. Fully dark.',
              stops:
                'var(--color-sky-night) 0%, var(--color-sky-night) 30%, var(--color-sky-dusk) 36%, var(--color-sky-day) 42%, var(--color-sky-day) 56%, var(--color-sky-dusk) 62%, var(--color-sky-night) 68%, var(--color-sky-night) 100%',
            },
          ].map((row) => (
            <div>
              <div class="flex items-baseline justify-between gap-3">
                <span class="text-sm font-medium">{row.month}</span>
                <span class="nums text-lg font-semibold">16:00</span>
              </div>
              <div
                class="sky-strip relative mt-2.5 h-2.5 overflow-hidden rounded-full"
                style={`--sky-stops: ${row.stops}`}
                aria-hidden="true"
              >
                <div
                  class="sky-marker absolute top-0 h-full w-0.5 rounded-full bg-paper-900"
                  style="left: calc(66.6% - 1px)"
                />
              </div>
              <p class="mt-2.5 text-xs text-paper-500">{row.note}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Faq faqs={faqs} />
</Base>
