---
/**
 * The question list, shared by every page that has one.
 *
 * Uses native `details`/`summary`, so it collapses with zero JavaScript and
 * stays keyboard- and screen-reader-operable for free. The JSON-LD FAQPage
 * markup stays with each page, since only the page knows its own schema block.
 */
interface Props {
  faqs: Array<{ q: string; a: string }>;
  eyebrow?: string;
  heading?: string;
  /** Two columns suit a long list; one keeps a short list from looking sparse. */
  columns?: 1 | 2;
}

const { faqs, eyebrow = 'Questions', heading = 'Common questions', columns = 2 } = Astro.props;
---

<section class="mt-24 sm:mt-32">
  <p class="text-xs font-semibold tracking-widest text-paper-500 uppercase">{eyebrow}</p>
  <h2 class="mt-4 text-2xl font-semibold tracking-tight sm:text-3xl">{heading}</h2>

  <div class:list={['mt-7 grid gap-3', columns === 2 && 'lg:grid-cols-2']}>
    {
      faqs.map((f) => (
        <details class="elev group rounded-xl border border-paper-200 bg-white">
          <summary class="ring-focus flex cursor-pointer list-none items-center justify-between gap-4 rounded-xl px-5 py-4 text-sm font-medium">
            {f.q}
            <span
              class="shrink-0 text-paper-500 transition-transform group-open:rotate-45"
              aria-hidden="true"
            >
              <svg width="14" height="14" viewBox="0 0 14 14">
                <path
                  d="M7 2v10M2 7h10"
                  stroke="currentColor"
                  stroke-width="1.6"
                  stroke-linecap="round"
                  fill="none"
                />
              </svg>
            </span>
          </summary>
          <p class="px-5 pb-4 text-sm leading-relaxed text-paper-700">{f.a}</p>
        </details>
      ))
    }
  </div>
</section>
